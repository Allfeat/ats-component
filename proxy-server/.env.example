# ATS Proxy Server Environment Variables
# Copy this file to .env and fill in your values

# Backend API configuration
APP__BACKEND__API_KEY=aft_your_api_key_here
APP__BACKEND__PASSPHRASE=your_passphrase_here
APP__BACKEND__API_URL=http://localhost:13002
APP__BACKEND__NETWORK=testnet

# Server configuration (optional - defaults in config/default.toml)
# APP__SERVER__PORT=3333
# APP__SERVER__HOST=0.0.0.0

# Logging level (optional)
# RUST_LOG=ats_proxy_server=debug,tower_http=debug
