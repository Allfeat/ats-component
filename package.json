{
  "name": "allfeat-ats-component",
  "version": "1.0.0",
  "type": "module",
  "description": "Framework-agnostic web component for registering ATS works on Allfeat blockchain",
  "main": "dist/allfeat-ats-register.cjs.js",
  "module": "dist/allfeat-ats-register.esm.js",
  "browser": "dist/allfeat-ats-register.iife.js",
  "types": "dist/allfeat-ats-register.d.ts",
  "exports": {
    ".": {
      "import": "./dist/allfeat-ats-register.esm.js",
      "require": "./dist/allfeat-ats-register.cjs.js",
      "browser": "./dist/allfeat-ats-register.iife.js",
      "types": "./dist/allfeat-ats-register.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "serve": "npx serve -l 3000",
    "deploy:r2": "npm run build && bash scripts/deploy-r2.sh"
  },
  "keywords": [
    "allfeat",
    "ats",
    "blockchain",
    "web-component",
    "custom-element",
    "zkp",
    "zero-knowledge-proof",
    "music",
    "copyright",
    "registration"
  ],
  "author": "Allfeat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allfeat/allfeat-ats-component"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.18.0",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
